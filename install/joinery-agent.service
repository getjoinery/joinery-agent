[Unit]
Description=Joinery Agent - Remote server management executor
# Not after PostgreSQL, and not pulling it in. The agent works without the
# database and reconnects when it comes; and where the data root is encrypted,
# PostgreSQL waits for the unlock while the agent must be up to say the machine
# is locked (specs/hosted_data_promise_disk_encryption.md D4).
After=network.target

[Service]
Type=simple
# The start guard. A self-update that installed a binary unable to start at
# all (built for another machine, a crash before main) would loop here for
# ever: the watchdog that puts the previous binary back lives in main, which
# such a binary never reaches. So before each start, while a swap is still on
# trial (.pending) and the previous binary is kept (.bak), the new one must
# answer --version; when it cannot, the previous one goes back and the new
# version is marked rejected, as the agent's own watchdog does. The leading -
# means a guard that fails can never keep the agent from starting.
ExecStartPre=-/bin/sh -c 'b=/usr/local/bin/joinery-agent; if [ -f "$$b.pending" ] && [ -f "$$b.bak" ] && ! timeout 10 "$$b" --version >/dev/null 2>&1; then head -n 1 "$$b.pending" > "$$b.rejected"; mv -f "$$b.bak" "$$b"; rm -f "$$b.pending"; echo "joinery-agent start guard: the new binary does not start; previous binary restored"; fi'
ExecStart=/usr/local/bin/joinery-agent
# The liveness watch. The agent says it is alive every half minute while it is,
# and states the watchdog's timeout itself (WATCHDOG_USEC), so an agent too old
# to send anything is never killed for silence. This line only lets systemd
# hear it. When a hung agent stops saying so (having logged why, with every
# goroutine's stack), systemd aborts it and Restart=always starts it again.
NotifyAccess=main
EnvironmentFile=-/etc/joinery-agent/joinery-agent.env
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

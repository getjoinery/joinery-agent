# Joinery Agent Configuration
#
# Database credentials are read automatically from Globalvars_site.php.
# You only need this file to override defaults or change the config path.

# Path to Joinery's Globalvars_site.php (default: /var/www/html/joinerytest/config/Globalvars_site.php)
# JOINERY_CONFIG=/var/www/html/mysite/config/Globalvars_site.php

# Override DB credentials (only if you can't use Globalvars_site.php)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=joinerytest
# DB_USER=postgres
# DB_PASSWORD=

# How often to check for new jobs (Go duration format)
POLL_INTERVAL=5s

# How often to update the heartbeat record
HEARTBEAT_INTERVAL=30s

# Agent identifier (shown in admin dashboard)
AGENT_NAME=joinery-agent
